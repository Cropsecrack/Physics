<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Complete 3D Fission Simulation & Analysis Dashboard</title>
    <style>
        body {
            margin: 0;
            background-color: #020617;
            color: #f8fafc;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }
        #hud {
            position: absolute;
            top: 15px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.92);
            padding: 14px 24px;
            border-radius: 12px;
            border: 1px solid #f59e0b;
            box-shadow: 0 4px 25px rgba(0,0,0,0.6);
            z-index: 10;
            width: 820px;
            text-align: center;
        }
        h1 { margin: 0 0 4px 0; font-size: 17px; color: #f59e0b; }
        p { margin: 0 0 8px 0; font-size: 12px; color: #cbd5e1; }
        .timeline-slider {
            width: 100%;
            cursor: pointer;
            accent-color: #f59e0b;
        }
        .controls {
            margin-top: 8px;
            display: flex;
            gap: 10px;
            justify-content: center;
        }
        button {
            background-color: #f59e0b;
            color: #020617;
            border: none;
            padding: 6px 14px;
            font-size: 12px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s;
        }
        button:hover { background-color: #d97706; color: white; }
        
        #data-panel {
            position: absolute;
            bottom: 15px;
            right: 20px;
            background: rgba(15, 23, 42, 0.92);
            width: 380px;
            padding: 12px;
            border-radius: 10px;
            border-left: 4px solid #f59e0b;
            text-align: left;
            font-size: 11px;
            z-index: 10;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }
        #data-panel h3 { margin: 0 0 4px 0; color: #f59e0b; font-size: 13px; }
        #data-panel p { margin: 3px 0; color: #e2e8f0; line-height: 1.3; }
        
        #stats {
            position: absolute;
            bottom: 15px;
            left: 20px;
            background: rgba(15, 23, 42, 0.92);
            width: 280px;
            padding: 12px;
            border-radius: 10px;
            border-left: 4px solid #10b981;
            text-align: left;
            font-size: 11px;
            z-index: 10;
            line-height: 1.4;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }
        #stats h3 { margin: 0 0 4px 0; color: #10b981; font-size: 13px; }
    </style>
    <!-- Include Three.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="hud">
        <h1>Fission Theory 3D Simulation & Analysis</h1>
        <p id="timeLabel">Phase 1: Initial State (Accelerating Spin)</p>
        <input type="range" id="timeSlider" class="timeline-slider" min="0" max="100" value="0" step="0.1">
        <div class="controls">
            <button onclick="playSim()">Play Slow Motion</button>
            <button onclick="pauseSim()">Pause</button>
            <button onclick="resetSim()">Reset</button>
        </div>
    </div>

    <div id="stats">
        <h3>Controlled Variables:</h3>
        - <strong>Earth Mass/Size:</strong> Constant in model<br>
        - <strong>Apollo Mission Data:</strong> Reference baseline<br>
        - <strong>Physics & Gravity:</strong> Applied laws<br>
        <hr style="border:0; border-top:1px solid #334155; margin:6px 0;">
        <strong>Live Metrics:</strong><br>
        Rotation Rate: <span id="statSpeed" style="color: #60a5fa;">10.0 RPM</span><br>
        Equatorial Bulge: <span id="statBulge">1.00x (Spherical)</span><br>
        Chunk Status: <span id="statChunk">Bound to Crust</span>
    </div>

    <div id="data-panel">
        <h3 id="panelStage">Stage: Initial State</h3>
        <p><strong>Key Parameters:</strong> <span id="panelParams">Extreme rotational velocity; early molten Earth state.</span></p>
        <p><strong>Physical Mechanics:</strong> <span id="panelMech">The newly formed Earth was hypothesized to be spinning at an impossibly high speed.</span></p>
        <p><strong>Scientific Weakness:</strong> <span id="panelWeak" style="color: #fca5a5;">Requires rotational energy violating angular momentum laws.</span></p>
    </div>

    <script>
        // Three.js Setup
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 3, 13);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        document.body.appendChild(renderer.domElement);

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambientLight);

        const pointLight = new THREE.PointLight(0xffedd5, 2.5, 50);
        pointLight.position.set(12, 12, 12);
        scene.add(pointLight);

        // Procedural Textures
        function createPlanetTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 1024; canvas.height = 512;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#1e3a8a';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < 400; i++) {
                let x = Math.random() * canvas.width, y = Math.random() * canvas.height, r = Math.random() * 40 + 10;
                let grad = ctx.createRadialGradient(x, y, 0, x, y, r);
                grad.addColorStop(0, '#f97316'); grad.addColorStop(1, 'transparent');
                ctx.fillStyle = grad; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
            }
            return new THREE.CanvasTexture(canvas);
        }

        function createChunkTexture() {
            const canvas = document.createElement('canvas');
            canvas.width = 512; canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#475569';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < 200; i++) {
                let x = Math.random() * canvas.width, y = Math.random() * canvas.height, r = Math.random() * 15 + 2;
                ctx.fillStyle = '#1e293b'; ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
            }
            return new THREE.CanvasTexture(canvas);
        }

        // Meshes
        const earthGeometry = new THREE.SphereGeometry(2.2, 64, 64);
        const earthMaterial = new THREE.MeshStandardMaterial({ map: createPlanetTexture(), roughness: 0.3, metalness: 0.1 });
        const earth = new THREE.Mesh(earthGeometry, earthMaterial);
        scene.add(earth);

        const chunkGeometry = new THREE.SphereGeometry(0.8, 32, 32);
        const chunkMaterial = new THREE.MeshStandardMaterial({ map: createChunkTexture(), roughness: 0.6 });
        const chunk = new THREE.Mesh(chunkGeometry, chunkMaterial);
        chunk.position.set(3.2, 0, 0);
        chunk.visible = false;
        scene.add(chunk);

        // UI Elements
        const slider = document.getElementById("timeSlider");
        const timeLabel = document.getElementById("timeLabel");
        const statSpeed = document.getElementById("statSpeed");
        const statBulge = document.getElementById("statBulge");
        const statChunk = document.getElementById("statChunk");

        const panelStage = document.getElementById("panelStage");
        const panelParams = document.getElementById("panelParams");
        const panelMech = document.getElementById("panelMech");
        const panelWeak = document.getElementById("panelWeak");

        let isPlaying = false;
        let animId;
        let currentEarthRotation = 0;

        function updateSimulation() {
            let val = parseFloat(slider.value);

            let spinSpeed = 0.02 + (val * 0.0038);
            currentEarthRotation += spinSpeed;
            earth.rotation.y = currentEarthRotation;
            chunk.rotation.y += spinSpeed * 1.3;

            let displayRPM = (10 + (val * 0.38)).toFixed(1);

            if (val < 25) {
                timeLabel.innerText = "Phase 1: Initial State (Accelerating Spin)";
                statSpeed.innerText = `${displayRPM} RPM`;
                statBulge.innerText = "1.00x (Spherical)";
                statChunk.innerText = "0 km (Bound)";

                panelStage.innerText = "Stage: Initial State";
                panelParams.innerText = "Extreme rotational velocity; early molten Earth state.";
                panelMech.innerText = "The newly formed Earth was hypothesized to be spinning at an impossibly high speed.";
                panelWeak.innerText = "Requires a rotational energy input that violates conservation of angular momentum laws.";

                earth.scale.set(1, 1, 1);
                chunk.visible = false;
            } 
            else if (val < 55) {
                timeLabel.innerText = "Phase 2: Bulge Phase (Centrifugal Distortion)";
                statSpeed.innerText = `${displayRPM} RPM`;
                let scaleFactor = 1.0 + ((val - 25) * 0.012);
                statBulge.innerText = scaleFactor.toFixed(2) + "x Distortion";
                statChunk.innerText = "Surface Stretching";

                panelStage.innerText = "Stage: Bulge Phase";
                panelParams.innerText = "Equatorial bulge formation under high centrifugal force.";
                panelMech.innerText = "Due to extreme centrifugal force from rapid spinning, an exaggerated bulge formed along Earth's equator.";
                panelWeak.innerText = "Physics calculations show Earth would break apart entirely rather than cleanly eject a moon.";

                earth.scale.set(scaleFactor, 1 / Math.sqrt(scaleFactor), scaleFactor);
                chunk.visible = false;
            } 
            else if (val < 85) {
                timeLabel.innerText = "Phase 3: Separation Phase (Chunk Ejection)";
                statSpeed.innerText = `${displayRPM} RPM (Peak)`;
                statBulge.innerText = "1.40x (Max Bulge)";
                let chunkScale = (val - 55) * 0.028;
                let chunkDist = 2.8 + ((val - 55) * 0.06);
                statChunk.innerText = `Detached (${(chunkScale * 600).toFixed(0)} km)`;

                panelStage.innerText = "Stage: Separation Phase";
                panelParams.innerText = "Detachment of a massive crust/mantle chunk.";
                panelMech.innerText = "A massive portion of Earth's outer material supposedly detached and flung off into space.";
                panelWeak.innerText = "Fails to account for why the Moon does not orbit along Earth's equatorial plane.";

                earth.scale.set(1.4, 0.75, 1.4);
                chunk.visible = true;
                chunk.scale.set(chunkScale, chunkScale, chunkScale);
                chunk.position.x = chunkDist;
            } 
            else {
                timeLabel.innerText = "Phase 4: Accretion Phase & Scientific Verdict";
                statSpeed.innerText = "Decaying Spin Rate";
                statBulge.innerText = "Bulge Collapsing";
                statChunk.innerText = "Unstable Orbit";

                panelStage.innerText = "Stage: Accretion & Scientific Verdict";
                panelParams.innerText = "Totally Rejected by modern dynamicists and physicists.";
                panelMech.innerText = "The historical model proposed by George Darwin in 1878 has been disproven by modern celestial mechanics.";
                panelWeak.innerText = "Rejected because Apollo rock compositions show distinct chemical ratios that do not match Earth's crust.";

                earth.scale.set(1.15, 0.9, 1.15);
                chunk.visible = true;
                chunk.scale.set(0.8, 0.8, 0.8);
                chunk.position.x = 4.8;
            }
        }

        slider.addEventListener("input", updateSimulation);

        function playSim() {
            if (!isPlaying) {
                isPlaying = true;
                loopAnim();
            }
        }

        function pauseSim() {
            isPlaying = false;
            cancelAnimationFrame(animId);
        }

        function resetSim() {
            pauseSim();
            slider.value = 0;
            currentEarthRotation = 0;
            updateSimulation();
        }

        function loopAnim() {
            if (isPlaying) {
                let v = parseFloat(slider.value);
                if (v < 100) {
                    slider.value = v + 0.1;
                    updateSimulation();
                    animId = requestAnimationFrame(loopAnim);
                } else {
                    isPlaying = false;
                }
            }
        }

        // Render Loop
        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }

        updateSimulation();
        animate();

        // Window Resize Handler
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>

</body>
</html>
